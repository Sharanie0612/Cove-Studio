; Shared installer strings. Keep placeholders and NSIS control sequences aligned.
LangString CoveText0 ${LANG_SIMPCHINESE} "Cove Studio ${COVE_VERSION} · 安装"
LangString CoveText0 ${LANG_ENGLISH} "Cove Studio ${COVE_VERSION} · Setup"
LangString CoveText1 ${LANG_SIMPCHINESE} "核心许可与第三方组件"
LangString CoveText1 ${LANG_ENGLISH} "Core license and third-party components"
LangString CoveText2 ${LANG_SIMPCHINESE} "Cove Studio 核心使用 MIT 许可证。"
LangString CoveText2 ${LANG_ENGLISH} "Cove Studio core uses the MIT license."
LangString CoveText3 ${LANG_SIMPCHINESE} "以下为核心 MIT 许可。第三方组件保留各自许可；安装后可在程序目录查看 THIRD-PARTY-NOTICES.md、licenses 和对应源码。"
LangString CoveText3 ${LANG_ENGLISH} "The core MIT license follows. Third-party components keep their own licenses. After installation, see THIRD-PARTY-NOTICES.md, licenses and corresponding source in the application folder."
LangString CoveText4 ${LANG_SIMPCHINESE} "继续(&N)"
LangString CoveText4 ${LANG_ENGLISH} "Continue(&N)"
LangString CoveText5 ${LANG_SIMPCHINESE} "正在安装 Cove Studio"
LangString CoveText5 ${LANG_ENGLISH} "Installing Cove Studio"
LangString CoveText6 ${LANG_SIMPCHINESE} "正在准备运行环境和核心插件，请稍候。"
LangString CoveText6 ${LANG_ENGLISH} "Preparing the runtime and core service. Please wait."
LangString CoveText7 ${LANG_SIMPCHINESE} "卸载 Cove"
LangString CoveText7 ${LANG_ENGLISH} "Uninstall Cove"
LangString CoveText8 ${LANG_SIMPCHINESE} "移除应用，保留你的插件和用户数据。"
LangString CoveText8 ${LANG_ENGLISH} "Remove the app while keeping your plugins and user data."
LangString CoveText9 ${LANG_SIMPCHINESE} "将移除 Cove 程序和快捷方式。你的连接配置、用户数据和 plugins 文件夹会保留。$\r$\n$\r$\n请先在 Cove 中保存工作并正常退出，再在 AI 客户端停用 Cove MCP。"
LangString CoveText9 ${LANG_ENGLISH} "Cove and its shortcuts will be removed. Connection settings, user data and the plugins folder are preserved.$\r$\n$\r$\nSave your work and exit Cove normally, then disable Cove MCP in your AI clients."
LangString CoveText10 ${LANG_SIMPCHINESE} "未检测到 Microsoft Edge WebView2 Runtime。$\r$\n$\r$\nCove Studio 需要它来显示界面。是否打开微软官方下载页面？请在该页面查看微软条款并安装 Evergreen Runtime，完成后返回继续。$\r$\n$\r$\n当前尚未覆盖应用文件。"
LangString CoveText10 ${LANG_ENGLISH} "Microsoft Edge WebView2 Runtime was not found.$\r$\n$\r$\nCove Studio needs it to display the interface. Open Microsoft's download page? Review Microsoft's terms there and install the Evergreen Runtime, then return to continue.$\r$\n$\r$\nNo application files have been replaced."
LangString CoveText11 ${LANG_SIMPCHINESE} "另一个 Cove 安装器正在运行，请完成或取消后重试。"
LangString CoveText11 ${LANG_ENGLISH} "Another Cove installer is running. Finish or cancel it, then try again."
LangString CoveText12 ${LANG_SIMPCHINESE} "检测到此安装目录中仍有 Cove 主窗口。$\r$\n$\r$\n请先保存工作。点击“确定”请求所有版本正常退出；如有活动任务，请在 Cove 中确认。主窗口完全退出后才会安装。MCP 客户端适配器与旧运行文件会保留。"
LangString CoveText12 ${LANG_ENGLISH} "Cove is still open in this installation.$\r$\n$\r$\nSave your work. OK requests a normal exit for all versions; confirm active work in Cove. Setup waits until every desktop closes. MCP client adapters and older runtime files are kept."
LangString CoveText13 ${LANG_SIMPCHINESE} "Cove 尚未完全退出，或要写入的文件仍被占用。请在 Cove 内确认退出；如同版本 MCP 文件被占用，请在客户端停用 Cove MCP 后重试。安装器没有强制结束任何进程。"
LangString CoveText13 ${LANG_ENGLISH} "Cove has not fully exited, or files are still in use. Confirm exit in Cove. If an MCP adapter locks files for this exact version, disable it in the client and retry. Setup does not force-stop any process."
LangString CoveText14 ${LANG_SIMPCHINESE} "无法确认安装目录可安全更新，请检查目录权限后重试。安装器尚未覆盖原版本文件。$\r$\n$MaintenanceOutput"
LangString CoveText14 ${LANG_ENGLISH} "Cannot verify that this folder is safe to update. Check permissions and try again. No existing runtime files have been replaced.$\r$\n$MaintenanceOutput"
LangString CoveText15 ${LANG_SIMPCHINESE} "新版运行文件未能完整保存，旧版本仍可继续使用。请检查磁盘空间和目录权限后重试。"
LangString CoveText15 ${LANG_ENGLISH} "Some new runtime files could not be saved. The old version remains available. Check disk space and folder permissions, then retry."
LangString CoveText16 ${LANG_SIMPCHINESE} "Cove 或 MCP 适配器仍在使用安装文件。请正常退出 Cove，并在 AI 客户端停用 Cove 后重新卸载。工具会话与安装文件已保留。"
LangString CoveText16 ${LANG_ENGLISH} "Cove or an MCP adapter is using installation files. Exit Cove normally and disable Cove MCP in your AI clients before uninstalling. Tool sessions and installation files are preserved."
LangString CoveText17 ${LANG_SIMPCHINESE} "你的工具，一个工作台。"
LangString CoveText17 ${LANG_ENGLISH} "Your tools. One workspace."
LangString CoveText18 ${LANG_SIMPCHINESE} "安装位置"
LangString CoveText18 ${LANG_ENGLISH} "Install location"
LangString CoveText19 ${LANG_SIMPCHINESE} "更改…"
LangString CoveText19 ${LANG_ENGLISH} "Change…"
LangString CoveText20 ${LANG_SIMPCHINESE} "安装前会请求旧主程序正常退出，保留设置与插件"
LangString CoveText20 ${LANG_ENGLISH} "Setup closes the old desktop and keeps settings and plugins."
LangString CoveText21 ${LANG_SIMPCHINESE} "WebView2 已就绪 · Python 运行环境已包含"
LangString CoveText21 ${LANG_ENGLISH} "WebView2 ready · Python runtime included"
LangString CoveText22 ${LANG_SIMPCHINESE} "需要先安装 Microsoft WebView2 Runtime"
LangString CoveText22 ${LANG_ENGLISH} "Microsoft WebView2 Runtime is required"
LangString CoveText23 ${LANG_SIMPCHINESE} "微软官方下载"
LangString CoveText23 ${LANG_ENGLISH} "Microsoft download"
LangString CoveText24 ${LANG_SIMPCHINESE} "继续(&N)"
LangString CoveText24 ${LANG_ENGLISH} "Continue(&N)"
LangString CoveText25 ${LANG_SIMPCHINESE} "选择 Cove Studio 安装目录"
LangString CoveText25 ${LANG_ENGLISH} "Choose Cove Studio installation folder"
LangString CoveText26 ${LANG_SIMPCHINESE} "请选择完整的安装目录。"
LangString CoveText26 ${LANG_ENGLISH} "Choose a full installation path."
LangString CoveText27 ${LANG_SIMPCHINESE} "安装完成，可以开始工作了。"
LangString CoveText27 ${LANG_ENGLISH} "Installed. Ready to work."
LangString CoveText28 ${LANG_SIMPCHINESE} "已安装 ${COVE_VERSION}。快捷方式将通过固定入口打开当前版本。$\r$\n$INSTDIR"
LangString CoveText28 ${LANG_ENGLISH} "Version ${COVE_VERSION} is installed. Shortcuts open the current version through a stable entry.$\r$\n$INSTDIR"
LangString CoveText29 ${LANG_SIMPCHINESE} "完成后打开 Cove Studio ${COVE_VERSION}"
LangString CoveText29 ${LANG_ENGLISH} "Open Cove Studio ${COVE_VERSION} when finished"
LangString CoveText30 ${LANG_SIMPCHINESE} "完成(&F)"
LangString CoveText30 ${LANG_ENGLISH} "Finish(&F)"
LangString CoveText31 ${LANG_SIMPCHINESE} "新版本尚未启用，安装文件或快捷方式校验失败。请重试安装。旧版本和用户数据仍保留。$\r$\n$MaintenanceOutput"
LangString CoveText31 ${LANG_ENGLISH} "The new version was not activated because a file or shortcut check failed. Retry setup. Older versions and user data are preserved.$\r$\n$MaintenanceOutput"
