{
  "sdkVersion": 1,
  "id": "community.text-report",
  "name": "文本报告",
  "description": "用 Python 返回普通数据，由 Cove 显示统计和词频表格。",
  "version": "0.1.0",
  "author": "Community",
  "category": "示例",
  "icon": "file-chart-column",
  "color": "blue",
  "permissions": [],
  "commands": ["analyze"],
  "compatibility": {"minHostVersion": "0.11.0", "capabilities": ["ui.form", "ui.result"]},
  "ui": {
    "surface": "form",
    "fields": [{"id": "text", "label": "文本", "type": "text", "default": "Hello Cove hello plugins", "required": true}],
    "actions": [{"command": "analyze", "label": "分析文本", "variant": "primary"}],
    "empty": {"title": "把数据交给 Cove", "description": "这个插件无需前端代码，即可使用统一的统计卡片和表格。"},
    "result": {
      "title": "文本分析",
      "fields": [
        {"key": "characters", "label": "字符数", "format": "number"},
        {"key": "words", "label": "词数", "format": "number"},
        {"key": "unique", "label": "不同词语", "format": "number"}
      ],
      "table": {"key": "frequencies", "columns": [
        {"key": "word", "label": "词语"},
        {"key": "count", "label": "次数", "format": "number"}
      ], "emptyText": "没有可统计的词语"}
    }
  },
  "ai": {"tools": [{"name": "analyze", "command": "analyze", "description": "统计文本字符数、词数和词频，无外部读写。", "readOnly": true, "parameters": {"type": "object", "properties": {"text": {"type": "string", "maxLength": 20000}}, "required": ["text"], "additionalProperties": false}}]}
}
