{
  "name": "cove-workbench",
  "version": "0.13.0",
  "private": true,
  "description": "Schema-driven Python plugin workbench",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": ".venv\\Scripts\\python.exe -m toolbench",
    "desktop:dev": ".venv\\Scripts\\python.exe -m toolbench --dev",
    "test:plugins": ".venv\\Scripts\\python.exe -m unittest discover -s tests -v",
    "test:frontend": "node --experimental-strip-types scripts/verify_frontend.mjs && node --experimental-strip-types scripts/verify_assistant_state.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write src playwright.config.ts tests/ui",
    "format:check": "prettier --check src playwright.config.ts tests/ui",
    "test:i18n": "node --experimental-strip-types scripts/verify_i18n.mjs",
    "test:contribution": "node scripts/verify_contribution.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
