{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cove Plugin SDK v1",
  "type": "object",
  "required": [
    "sdkVersion",
    "id",
    "name",
    "description",
    "version",
    "author",
    "category",
    "permissions",
    "commands",
    "ui"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sdkVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "预留元数据，v1 使用统一图标"
    },
    "color": {
      "type": "string",
      "description": "预留元数据，v1 使用工作台主题"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "ui": {
      "type": "object",
      "required": [
        "surface",
        "fields",
        "actions"
      ],
      "properties": {
        "surface": {
          "enum": [
            "terminal",
            "form",
            "mcp"
          ]
        },
        "profiles": {
          "type": "object",
          "required": [
            "list",
            "scan",
            "save",
            "remove"
          ],
          "properties": {
            "list": {
              "type": "string"
            },
            "scan": {
              "type": "string"
            },
            "save": {
              "type": "string"
            },
            "remove": {
              "type": "string"
            },
            "restore": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "label"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "variant": {
                "const": "primary"
              }
            },
            "additionalProperties": false
          }
        },
        "connection": {
          "type": "object",
          "required": [
            "connect",
            "disconnect"
          ],
          "properties": {
            "connect": {
              "type": "string"
            },
            "disconnect": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "terminal": {
          "type": "object",
          "required": [
            "write",
            "resize",
            "dataEvent"
          ],
          "properties": {
            "write": {
              "type": "string"
            },
            "resize": {
              "type": "string"
            },
            "dataEvent": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "empty": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "object",
          "properties": {
            "idle": {
              "type": "string"
            },
            "connected": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "confirmations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/confirmation"
          }
        },
        "instrument": {
          "type": "object",
          "required": [
            "status",
            "measure",
            "waveform",
            "screenshot",
            "acquisition",
            "timebase",
            "channel",
            "trigger",
            "snapshot"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "measure": {
              "type": "string"
            },
            "waveform": {
              "type": "string"
            },
            "screenshot": {
              "type": "string"
            },
            "acquisition": {
              "type": "string"
            },
            "timebase": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            },
            "trigger": {
              "type": "string"
            },
            "snapshot": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "$ref": "#/$defs/resultLayout"
        },
        "job": {
          "type": "object",
          "required": [
            "snapshot",
            "cancel"
          ],
          "properties": {
            "snapshot": {
              "type": "string"
            },
            "cancel": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "result"
            ]
          },
          "then": {
            "properties": {
              "surface": {
                "const": "form"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "job"
                  ]
                },
                {
                  "required": [
                    "instrument"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "surface": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "required": [
              "connection",
              "terminal"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "required": [
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": [
              "name",
              "command",
              "description",
              "readOnly",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "readOnly": {
                "type": "boolean"
              },
              "parameters": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minHostVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "maxHostVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "required": [
        "defaultLocale",
        "messages"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultLocale": {
          "enum": [
            "zh-CN",
            "en-US"
          ]
        },
        "messages": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "zh-CN",
              "en-US"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "maxProperties": 2000,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ui": {
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "ui"
        ]
      },
      "then": {
        "required": [
          "compatibility"
        ],
        "properties": {
          "compatibility": {
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "ui.result"
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "resultField": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "format": {
          "enum": [
            "text",
            "number",
            "json"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      },
      "additionalProperties": false
    },
    "resultLayout": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "table"
          ]
        }
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/resultField"
          }
        },
        "table": {
          "type": "object",
          "required": [
            "key",
            "columns"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/resultField"
              }
            },
            "emptyText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "password",
            "number",
            "select"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "advanced": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "number"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "showWhen": {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "equals": {
              "type": "string"
            },
            "notEquals": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "required": [
        "code",
        "title",
        "description",
        "confirmLabel",
        "details",
        "payload"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "confirmLabel": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "fromDetail"
            ],
            "properties": {
              "fromDetail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
